{
  "providers": [
    {
      "name": "nvidia",
      "label": "NVIDIA NIM (lokál bridge)",
      "adapter": "nvidia",
      "enabled": true,
      "priority": 10,
      "models": [
        { "id": "moonshotai/kimi-k2.6", "tags": ["chat", "cs", "tools", "reason", "code"], "costPerMTokIn": 0, "costPerMTokOut": 0 }
      ],
      "config": {
        "baseUrl": "${NVIDIA_BRIDGE_URL}",
        "chatPath": "/api/chat",
        "healthPath": "/health",
        "usagePath": "/api/usage"
      }
    },
    {
      "name": "opencode-zen",
      "label": "OpenCode Zen (free)",
      "adapter": "opencodeZen",
      "enabled": true,
      "priority": 30,
      "models": [
        { "id": "big-pickle", "tags": ["chat", "cs", "tools"], "costPerMTokIn": 0, "costPerMTokOut": 0 }
      ],
      "config": {
        "baseUrl": "https://opencode.ai/zen",
        "chatPath": "/v1/chat/completions",
        "apiKeyEnv": "OPENCODE_ZEN_KEY"
      }
    },
    {
      "name": "gemini",
      "label": "Google Gemini (free tier)",
      "adapter": "gemini",
      "enabled": true,
      "priority": 50,
      "models": [
        { "id": "gemini-2.5-flash", "tags": ["chat", "cs", "tools", "fast", "translate", "correct"], "costPerMTokIn": 0, "costPerMTokOut": 0 },
        { "id": "gemini-2.5-pro", "tags": ["chat", "cs", "reason", "translate", "correct"], "costPerMTokIn": 0, "costPerMTokOut": 0 }
      ],
      "config": {
        "baseUrl": "https://generativelanguage.googleapis.com",
        "apiKeyEnv": "GEMINI_API_KEY"
      }
    }
  ]
}
